# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/samgov_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-256-bit-secret-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_INTELLIGENCE=price_...
STRIPE_PRICE_ID_COMPLETE=price_...

# Storage Configuration
# Options: "local" (development) or "r2" (production)
STORAGE_TYPE=local

# Local Storage (for development)
LOCAL_STORAGE_PATH=./storage/documents

# Cloudflare R2 (for production)
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=samgov-docs-staging
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Encryption (generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@your-domain.com

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Sentry (optional)
SENTRY_DSN=
